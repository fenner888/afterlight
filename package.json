{
  "name": "afterlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test --project=chrome",
    "test:cross": "playwright test --project=webkit --project=firefox --grep @smoke",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
